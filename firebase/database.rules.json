{
  "rules": {
    ".read": false,
    ".write": false,

    "admins": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": false
    },

    "config": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "tableCount":    { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 50" },
      "menuSheetId":   { ".validate": "newData.isString() && newData.val().length < 200" },
      "menuSheetName": { ".validate": "newData.isString() && newData.val().length < 100" },
      "scriptUrl":     { ".validate": "newData.isString() && newData.val().length < 400 && (newData.val().length == 0 || newData.val().beginsWith('https://script.google.com/'))" },
      "$other":        { ".validate": false }
    },

    "orderCounter": {
      ".read": true,
      ".write": true,
      ".validate": "newData.isNumber() && newData.val() === (data.exists() ? data.val() + 1 : 1)"
    },

    "orders": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".indexOn": ["time"],
      "$num": {
        ".write": "(!data.exists() && newData.exists()) || (auth != null && root.child('admins').child(auth.uid).val() === true)",
        ".validate": "$num.matches(/^[1-9][0-9]*$/) && newData.hasChildren(['num','table','status','time','total','items'])",
        "num":    { ".validate": "newData.isNumber() && newData.val() >= 1" },
        "table":  { ".validate": "newData.isNumber() && newData.val() >= 0 && (root.child('config/tableCount').exists() ? newData.val() < root.child('config/tableCount').val() : newData.val() < 12)" },
        "status": { ".validate": "newData.isString() && ((auth != null && root.child('admins').child(auth.uid).val() === true) ? newData.val().matches(/^(new|preparing|delivered)$/) : newData.val() === 'new')" },
        "time":   { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+Z$/)" },
        "total":  { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 10000" },
        "items":  { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 4000" },
        "note":   { ".validate": "newData.isString() && newData.val().length <= 300" },
        "$other": { ".validate": false }
      }
    },

    "archive": {
      ".read":  "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    }
  }
}
